rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isTeacher() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.matches('.*@qfm\\.kh\\.edu\\.tw$');
    }

    match /classrooms/classboard-807 {
      allow read: if true;
      allow create: if isTeacher()
        && request.resource.data.syncVersion == 2
        && request.resource.data.revision == 1;
      allow update: if isTeacher()
        && request.resource.data.syncVersion == 2
        && request.resource.data.revision == resource.data.get('revision', 0) + 1;
      allow delete: if isTeacher();

      // Only fun scores are public-writable; classroom/teacher data stays protected.
      match /gameRankings/{bucket} {
        function puzzleBucket() {
          return bucket.matches('^(spot-difference|memory-match|balance-ball|light-maze|bubble-connect)-(1|2|3)$');
        }
        function validBucket() {
          return bucket.matches('^(mole-pop|moving-dot)-(30|60|90)$') || puzzleBucket() || bucket == 'tic-tac-toe-wins';
        }
        function validScore(scoreId) {
          let data = request.resource.data;
          return validBucket()
            && scoreId.size() <= 200
            && data.keys().hasAll(['score','date','time','label','participant','client','createdAt'])
            && data.keys().hasOnly(['score','date','time','label','participant','client','createdAt'])
            && data.score is int && data.score >= -10000 && data.score <= 100000
            && (!puzzleBucket() || (data.score >= 0 && data.score <= 1000))
            && data.date is string && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
            && data.time is int && data.time > 0 && data.time <= 4102444800000
            && data.label is string && data.label.size() <= 40
            && data.client is string && data.client.matches('^[a-zA-Z0-9_-]{8,80}$')
            && scoreId.matches('^' + data.client + '_[a-zA-Z0-9:_-]+$')
            && data.participant is string
            && ((bucket == 'tic-tac-toe-wins' && data.participant.matches('^[0-3]:[OX]$') && data.score >= 1)
              || (bucket != 'tic-tac-toe-wins' && data.participant == ''));
        }
        function newScore(scoreId) {
          return validScore(scoreId) && request.resource.data.createdAt == request.time;
        }
        function increasedWins(scoreId) {
          return validScore(scoreId) && bucket == 'tic-tac-toe-wins'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['score'])
            && request.resource.data.score > resource.data.score;
        }
        match /scores/{scoreId} {
          allow read: if validBucket();
          allow create: if newScore(scoreId);
          allow update: if increasedWins(scoreId);
          allow delete: if isTeacher();
        }
        match /days/{date}/scores/{scoreId} {
          allow read: if validBucket();
          allow create: if newScore(scoreId) && request.resource.data.date == date;
          allow update: if increasedWins(scoreId) && request.resource.data.date == date;
          allow delete: if isTeacher();
        }
      }

      match /restorePoints/{pointId} {
        allow read: if isTeacher();
        allow create, update: if isTeacher()
          && pointId.matches('^point-([0-9]|[12][0-9])$')
          && request.resource.data.data is map
          && request.resource.data.sequence is int
          && request.resource.data.createdAt == request.time;
        allow delete: if false;
      }

      match /teacherPrivate/restoreMeta {
        allow read, create, update: if isTeacher();
        allow delete: if false;
      }

      match /courseCompletions/{completionId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['subject', 'taskId', 'seat', 'createdAt'])
          && request.resource.data.subject is string
          && request.resource.data.taskId is string
          && request.resource.data.seat is int
          && request.resource.data.seat >= 1
          && request.resource.data.seat <= 60
          && request.resource.data.createdAt is string;
        allow update: if false;
        allow delete: if true;
      }

      match /notebookCheckins/{checkinId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['seat', 'date', 'timestamp'])
          && request.resource.data.seat is int
          && request.resource.data.seat >= 1
          && request.resource.data.seat <= 60
          && request.resource.data.date is string
          && request.resource.data.timestamp is string;
        allow update, delete: if false;
      }

      match /tomorrowSubmissions/{submissionId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['text', 'author', 'subject', 'handwriting', 'createdAt', 'targetDate'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.author is string
          && request.resource.data.author.size() <= 100
          && request.resource.data.subject is string
          && request.resource.data.subject.size() <= 40
          && request.resource.data.handwriting is string
          && request.resource.data.handwriting.size() <= 160000
          && request.resource.data.createdAt is string
          && request.resource.data.targetDate is string
          && request.resource.data.targetDate.matches('^\\d{4}-\\d{2}-\\d{2}$');
        allow update: if isTeacher() || (exists(/databases/$(database)/documents/classrooms/classboard-807/editRequests/$(submissionId))
          && get(/databases/$(database)/documents/classrooms/classboard-807/editRequests/$(submissionId)).data.taskId == submissionId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'author', 'subject', 'handwriting', 'updatedAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.author is string
          && request.resource.data.author.size() <= 100
          && request.resource.data.subject is string
          && request.resource.data.subject.size() <= 40
          && request.resource.data.handwriting is string
          && request.resource.data.handwriting.size() <= 160000
          && request.resource.data.updatedAt is string);
        allow delete: if isTeacher() || (exists(/databases/$(database)/documents/classrooms/classboard-807/deleteRequests/$(submissionId))
          && get(/databases/$(database)/documents/classrooms/classboard-807/deleteRequests/$(submissionId)).data.taskId == submissionId);
      }

      match /stickyMessages/{dayKey}/notes/{slotId} {
        allow read: if true;
        allow create: if slotId.matches('^slot-(0[1-9]|1[0-9]|2[0-8])$')
          && request.resource.data.keys().hasOnly(['day', 'slot', 'text', 'createdAt'])
          && request.resource.data.day == dayKey
          && request.resource.data.slot == slotId
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 20
          && request.resource.data.createdAt is string;
        allow update, delete: if false;
      }

      match /teacherPrivate/dailyConfirmation {
        allow read, create, update, delete: if isTeacher();
      }

      match /deleteRequests/{submissionId} {
        allow create: if request.resource.data.keys().hasOnly(['taskId', 'code', 'date', 'requestedAt'])
          && request.resource.data.taskId == submissionId
          && request.resource.data.code is string
          && request.resource.data.code.matches('^\\d{4}$')
          && request.resource.data.date is string
          && request.resource.data.requestedAt is string
          && exists(/databases/$(database)/documents/classrooms/classboard-807/teacherPrivate/dailyConfirmation)
          && get(/databases/$(database)/documents/classrooms/classboard-807/teacherPrivate/dailyConfirmation).data.date == request.resource.data.date
          && get(/databases/$(database)/documents/classrooms/classboard-807/teacherPrivate/dailyConfirmation).data.code == request.resource.data.code;
        allow read, update, delete: if false;
      }

      match /editRequests/{submissionId} {
        allow create: if request.resource.data.keys().hasOnly(['taskId', 'code', 'date', 'requestedAt'])
          && request.resource.data.taskId == submissionId
          && request.resource.data.code is string
          && request.resource.data.code.matches('^\\d{4}$')
          && request.resource.data.date is string
          && request.resource.data.requestedAt is string
          && exists(/databases/$(database)/documents/classrooms/classboard-807/teacherPrivate/dailyConfirmation)
          && get(/databases/$(database)/documents/classrooms/classboard-807/teacherPrivate/dailyConfirmation).data.date == request.resource.data.date
          && get(/databases/$(database)/documents/classrooms/classboard-807/teacherPrivate/dailyConfirmation).data.code == request.resource.data.code;
        allow read, update: if false;
        allow delete: if true;
      }
    }
  }
}
